#!/bin/sh
# Launches the tool through `open -a` rather than executing it directly.
#
# TCC attributes a directly-executed binary to whatever process started the
# shell, so Photos access gets decided for *that* process — which usually means
# an instant denial with no prompt. Going through `open` makes launchd the
# parent, so the app is judged on its own bundle identity and can prompt.
# stdout is discarded in that case, hence --log plus a tail.
set -e

here=$(cd "$(dirname "$0")" && pwd)
app="$here/ApplePhotosSync.app"
bin="$app/Contents/MacOS/apple-photos-sync"

if [ ! -x "$bin" ]; then
	echo "apple-photos-sync: not built yet — run 'make' in $here" >&2
	exit 1
fi

log=$(mktemp -t apple-photos-sync)
trap 'rm -f "$log"' EXIT

open -a "$app" --args "$@" --log "$log"

# Poll the log rather than backgrounding `tail -f`: an orphaned tail would keep
# this script's stdout open after we exit, hanging whoever called us.
next=1
drain() {
	total=$(wc -l <"$log" | tr -d ' ')
	if [ "$total" -ge "$next" ]; then
		sed -n "${next},\$p" "$log" | grep -v '^##exit ' || true
		next=$((total + 1))
	fi
}

running() {
	pgrep -qf "ApplePhotosSync.app/Contents/MacOS/apple-photos-sync"
}

# Completion is the "##exit" marker in the log, not the process disappearing:
# a cold launch can take seconds to show up in pgrep, and waiting on a fixed
# appearance window loses the whole run when it does. Only conclude the process
# died without finishing once we have actually seen it running.
seen=0
waited=0
while :; do
	drain
	if grep -q '^##exit ' "$log"; then
		break
	fi
	if running; then
		seen=1
	elif [ "$seen" = 0 ]; then
		# Never showed up at all: bound the wait so a failed launch cannot hang.
		waited=$((waited + 1))
		if [ $waited -gt 200 ]; then
			echo "apple-photos-sync: app did not start" >&2
			exit 1
		fi
	else
		sleep 0.5
		drain
		grep -q '^##exit ' "$log" || {
			echo "apple-photos-sync: exited without finishing" >&2
			exit 1
		}
		break
	fi
	sleep 0.3
done
drain

status=$(sed -n 's/^##exit //p' "$log" | tail -1)
exit "${status:-1}"
